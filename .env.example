# Copie para .env (ou exporte no terminal) e preencha.

# Leitura de documentos via OpenRouter
OPENROUTER_API_KEY=
# Identificador do modelo de visão no OpenRouter (ex.: o slug do Nemotron VL)
OPENROUTER_MODEL=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Dados locais
SECURITY_AI_DATA_DIR=Data
SECURITY_AI_GABARITO=train.jsonl
